enum Role {
  SUPER_ADMIN
  ADMIN
  AGENT
  CUSTOMER
}

enum Status {
  ACTIVE
  BLOCKED
  SUSPENDED
}

model User {
  id                    String    @id @default(uuid())
  email                 String    @unique
  phone                 String?   @unique
  password              String
  pin                   String?
  role                  Role      @default(CUSTOMER)
  isVerified            Boolean   @default(false)
  isPinSet              Boolean   @default(false)
  status                Status    @default(ACTIVE)
  isDefaultPassword     Boolean   @default(false)
  defaultPasswordExpiry DateTime?
  createdById           String?
  maxDeviceAllowed      Int       @default(1)
  balance               Float     @default(0.0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // relations
  profile  Profile?
  sessions Session[]
  contacts UserContact[] @relation("ContactOwner")
  savedBy  UserContact[] @relation("SavedUser")
  createdBy    User?  @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdUsers User[] @relation("UserCreatedBy")
  notifications     Notification[]
  requestedMoney    Request[]      @relation("RequestRequester")
  receivedMoney     Request[]      @relation("RequestReceiver")
  processedRequests Request[]      @relation("RequestProcessedBy")
  wallet                Wallet?
  
  initiatedTransactions Transaction[]

  @@map("users")
}
